# --- ProcessGPT platform ---
SUPABASE_URL=
# Service-role key: polling, chat storage, the room-tenant check on
# attach/stop/steer, tenant lookup for chat auth, and the session archive.
SUPABASE_KEY=
# Chat verifies the caller's tenant from their Supabase JWT. Optional: set it to
# verify HS256 tokens locally; without it asymmetric tokens go through JWKS
# (from SUPABASE_URL) and HS256 ones are checked by GoTrue.
SUPABASE_JWT_SECRET=
# Download links for chat outputs (files the agent leaves in outputs/). Unset:
# the turn still completes and says which files got no link.
MEMENTO_BASE_URL=

# --- CLI agent credentials ---------------------------------------------
# Each CLI authenticates itself; this service never handles the tokens.
# Two paths run unattended, and only one of them should be set — with both, which
# account gets billed depends on the CLI version rather than on your intent.
#
# 1. Subscription token — `claude setup-token` on a machine already logged into
#    the subscription. Long-lived, so nothing has to be written back when it
#    refreshes; that is what lets it survive a read-only secret mount. Same seat
#    as a developer's own login, so model access matches what they see locally,
#    and the rate limit is that account's — the first thing to give way when
#    concurrency goes up.
CLAUDE_CODE_OAUTH_TOKEN=
# 2. API key — billed to the organisation's API account, with the organisation's
#    limits, rotatable without logging in anywhere.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Subscription login instead of a key: mount the CLI's credential directory
# read-only and point it here. Note that Codex keeps MCP registrations in the
# same directory, so this must NOT be the same path a run is isolated into.
# CODEX_HOME=/secrets/codex

# --- Execution ----------------------------------------------------------
# Work items only. A chat must name its CLI (metadata.agent_cli) or is refused.
CLIAGENTS_DEFAULT_CLI=claude-code
# read_only | workspace_write | command_exec. Default stays inside the run's
# own directory; command_exec is an explicit, per-work-item choice.
CLIAGENTS_DEFAULT_PERMISSION=workspace_write
CLIAGENTS_MAX_CONCURRENT_RUNS=3
# false in a per-conversation chat runner Pod: it must not claim work items,
# because the session router reclaims idle Pods and the item would stop with it.
CLIAGENTS_PROCESS_POLLING=true
CLIAGENTS_RUN_TIMEOUT_SECONDS=1800

# --- Storage ------------------------------------------------------------
CLIAGENTS_WORKSPACE_ROOT=/workspace
# How long a finished run can still be resumed and downloaded from.
CLIAGENTS_WORKSPACE_RETENTION_HOURS=72
SKILLS_DIRS=/app/skills
CLIAGENTS_SYSTEM_SKILLS_DIR=/app/system-skills

HOST=0.0.0.0
PORT=8890
